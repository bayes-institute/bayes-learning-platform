NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_API_ORIGIN=http://localhost:8000

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Local development only. Cloud Run uses the service account attached to each
# deployed service and does not need a downloaded key. Prefer
# GOOGLE_APPLICATION_CREDENTIALS locally; it points to an ignored JSON file.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional local fallback if GOOGLE_APPLICATION_CREDENTIALS is not used.
# Generate these from a Firebase service account and never commit the values.
# For hosts that store multiline values in one line, keep private-key newline
# markers as literal \n.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Used only by docker compose to mount an ignored local service-account JSON
# file into both development containers.
FIREBASE_ADMIN_CREDENTIALS_FILE=
