APPLICATION_ENV=development
SERVER_ALLOWED_CLIENT_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=

# Local development only. Cloud Run uses its assigned runtime service account.
# Point this to an ignored Firebase service-account JSON file when running the
# server locally.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional local fallback if GOOGLE_APPLICATION_CREDENTIALS is not used.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Used only by docker compose to mount an ignored local service-account JSON.
FIREBASE_ADMIN_CREDENTIALS_FILE=
